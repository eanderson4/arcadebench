# Provider credentials are read by the CLI and never written into run artifacts.
OPENAI_API_KEY=

# Optional source identity recorded in manifests created outside Git-aware CI.
ARCADEBENCH_REVISION=
ARCADEBENCH_GAME_REVISION=
ARCADEBENCH_DIRTY=0

# Optional public Partition score API. Unset uses a clearly labeled local board.
VITE_PARTITION_LEADERBOARD_API_URL=
