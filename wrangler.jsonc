{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "arcadebench",
  "main": "./deploy/worker.js",
  "compatibility_date": "2026-08-17",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "arcadebench.org",
      "custom_domain": true
    },
    {
      "pattern": "www.arcadebench.org",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist/site",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "arcadebench-platform",
      "database_id": "a1ae74c7-6583-4599-a626-4b6660199a65",
      "migrations_dir": "./apps/platform/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "REPLAYS",
      "bucket_name": "arcadebench-replays"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "8172601",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "EXPENSIVE_RATE_LIMITER",
      "namespace_id": "8172602",
      "simple": {
        "limit": 12,
        "period": 60
      }
    }
  ],
  "triggers": {
    "crons": ["17 4 * * *"]
  },
  "observability": {
    "enabled": true
  }
}
