{
  "name": "@arcadebench/maltline",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./competition-client": "./src/viewer/competition-client.ts",
    "./verifier": "./src/verifier.ts",
    "./testing": "./src/testing/index.ts"
  },
  "scripts": {
    "dev": "vite --open /src/viewer/",
    "dev:visual": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.json && vite build",
    "test": "vitest run",
    "test:visual": "playwright test --config=playwright.config.ts",
    "test:visual:update": "playwright test --config=playwright.config.ts --update-snapshots",
    "test:site": "node tools/built-site-smoke.mjs",
    "telemetry": "tsx tools/campaign-telemetry.ts",
    "recovery:p1-04": "tsx tools/p1-04-recovery-experiment.ts",
    "relief:p1-02": "tsx tools/p1-02-stage8-relief-experiment.ts",
    "tuning:p1-08": "tsx tools/p1-08-tuning-experiment.ts"
  },
  "devDependencies": {
    "@fontsource/noto-sans": "5.3.0",
    "@playwright/test": "1.63.0",
    "vite": "^8.3.0"
  }
}
